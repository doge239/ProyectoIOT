# Copia a backend/.env. No publicar secretos en Git.
DATABASE_URL=sqlite:///./data/parking.db
ADMIN_USERNAME=admin
# Generar con python -m backend.configure
ADMIN_PASSWORD_HASH=
# Claves >= 24 caracteres. Cada dispositivo puede reportar solo sus puestos.
DEVICE_KEYS={"REEMPLAZAR_POR_CLAVE_LARGA_ALEATORIA":["A1","A2","A3","A4"]}
# Solo para la demo local antigua. Prohibido en producción.
ALLOW_ANONYMOUS_TELEMETRY=false
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://localhost,capacitor://localhost
SESSION_HOURS=8
PORT=8080
HOST=127.0.0.1
